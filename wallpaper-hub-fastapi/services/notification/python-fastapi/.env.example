# Copy this file to .env (next to pyproject.toml). Never commit .env.
# If your Redis container requires a password, use: redis://:<password>@localhost:6379/0
NOTIFICATION_REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0

# Optional (defaults shown)
# NOTIFICATION_ENVIRONMENT=local
# NOTIFICATION_REDIS_CONNECT_TIMEOUT_SECONDS=1.0
# NOTIFICATION_REDIS_COMMAND_TIMEOUT_SECONDS=2.0
# NOTIFICATION_HEALTH_CHECK_TIMEOUT_SECONDS=1.0
