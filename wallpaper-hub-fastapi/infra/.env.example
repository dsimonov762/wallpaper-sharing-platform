# Copy to infra/.env (never commit that file). Dev-only values: use letters, digits and
# dashes only, because the Postgres init script puts them into SQL.
COMPOSE_PROFILES=infra

POSTGRES_ADMIN_PASSWORD=change-me-admin
ACCOUNT_DB_PASSWORD=change-me-account
MEDIA_DB_PASSWORD=change-me-media
KEYCLOAK_DB_PASSWORD=change-me-keycloak

REDIS_PASSWORD=change-me-redis

KEYCLOAK_ADMIN_PASSWORD=change-me-kc-admin

MONGO_ROOT_PASSWORD=change-me-root
CATALOG_DB_PASSWORD=change-me-catalog